[Unit]
Description=fuserd FUSER community server
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=fuserd
Group=fuserd
SupplementaryGroups=docker
WorkingDirectory=/opt/fuserd
ExecStart=/opt/fuserd/build/fuserd -config /opt/fuserd/config.json
Restart=on-failure
RestartSec=5s
# fuserd currently handles os.Interrupt, not SIGTERM. SIGINT lets it stop the
# Main Stage container and close the HTTP server before systemd ends the service.
KillSignal=SIGINT
TimeoutStopSec=120s
# Uncomment to listen on :443 (acme's tls-alpn-01 challenge arrives there) as the fuserd user.
#AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
